# OpenAI API Key (for GPT-4o narrative analysis & DALL-E 3 image generation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (for Gemini narrative analysis & Imagen 3 image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for Claude 3.5, Llama 3.3, and OpenRouter image models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Base URL (for local models, e.g. http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
